# Environment Variables Template
# Copy this file to .env.local and fill in your values

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/azure-blog

# Site Configuration (for SEO and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NextAuth Configuration
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# Shopify Storefront API
# Instructions: https://shopify.dev/docs/api/storefront
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token_here

# Giscus Comments (Optional)
NEXT_PUBLIC_GITHUB_OWNER=your-github-username
NEXT_PUBLIC_GITHUB_REPO=your-repo-name
NEXT_PUBLIC_GISCUS_REPO_ID=your_giscus_repo_id
NEXT_PUBLIC_GISCUS_CATEGORY_ID=your_giscus_category_id

# Google Analytics (Optional)
# GA4 Measurement ID from your property's Data Streams settings, e.g. G-XXXXXXXXXX
GA_MEASUREMENT_ID=

# Azure AD (Entra ID)
# Required for admin SSO login, and reused below to send mail via Microsoft
# Graph (no separate app registration needed).
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_CLIENT_SECRET=your-client-secret
AZURE_AD_TENANT_ID=your-tenant-id

# Ghiffa apartment booking notifications
# OWNER_EMAIL lists the account(s) authorized to approve/decline requests on
# /ghiffa, comma-separated for more than one. Checked against the signed-in
# session, so each address must be an individual mailbox someone actually
# signs in as - not a distribution list or group.
OWNER_EMAIL=you@example.com,co-owner@example.com

# Where the new-request notification email is delivered. Optional - falls
# back to OWNER_EMAIL if unset. Unlike OWNER_EMAIL this is never used for
# authorization, so it can safely be a distribution list or Microsoft 365
# Group address that nobody signs in as (e.g. a family group covering
# multiple people) - Microsoft Graph can send mail TO such an address, just
# not send mail FROM one (see MAIL_SENDER below).
NOTIFY_EMAIL=

# Mailbox that sends the owner notification and the confirmation/decline
# email to the requestor, via Microsoft Graph's /users/{MAIL_SENDER}/sendMail
# using the Azure AD app above (needs the Mail.Send application permission
# with admin consent in your tenant). Must be a real user or shared mailbox -
# Graph has no way to send mail "as" a distribution list or Microsoft 365
# Group. If left unset, booking requests still work and appear on /ghiffa,
# but no emails are sent (a warning is logged instead).
MAIL_SENDER=
