# Environment Variables Template
# Copy this file to .env.local and fill in your values

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/azure-blog

# Site Configuration (for SEO and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NextAuth Configuration
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# Shopify Storefront API
# Instructions: https://shopify.dev/docs/api/storefront
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token_here

# Giscus Comments (Optional)
NEXT_PUBLIC_GITHUB_OWNER=your-github-username
NEXT_PUBLIC_GITHUB_REPO=your-repo-name
NEXT_PUBLIC_GISCUS_REPO_ID=your_giscus_repo_id
NEXT_PUBLIC_GISCUS_CATEGORY_ID=your_giscus_category_id

# Google Analytics (Optional)
# GA4 Measurement ID from your property's Data Streams settings, e.g. G-XXXXXXXXXX
GA_MEASUREMENT_ID=

# Azure AD (Entra ID)
# Required for admin SSO login, and reused below to send mail via Microsoft
# Graph (no separate app registration needed).
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_CLIENT_SECRET=your-client-secret
AZURE_AD_TENANT_ID=your-tenant-id

# Ghiffa apartment booking notifications
# OWNER_EMAIL receives a notification for every new stay request and is the
# only address that can approve/decline requests (via the admin dashboard).
OWNER_EMAIL=you@example.com

# Mailbox that sends the owner notification and the confirmation/decline
# email to the requestor, via Microsoft Graph's /users/{MAIL_SENDER}/sendMail
# using the Azure AD app above (needs the Mail.Send application permission
# with admin consent in your tenant). If left unset, booking requests still
# work and appear in the admin dashboard, but no emails are sent (a warning
# is logged instead).
MAIL_SENDER=
